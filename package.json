{
  "name": "jonoblades.github.io",
  "version": "1.0.0",
  "description": "Jonoblades Homepage",
  "main": "src/site/index.html",
  "type": "module",
  "repository": "https://github.com/jonoblades/jonoblades.github.io.git",
  "author": "Jonathan <jonoblades@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "chart.js": "^4.5.1",
    "jsdom": "26",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.148.0"
  },
  "scripts": {
    "test": "vitest",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=junit --outputFile=test-report.junit.xml",
    "site-visits": "wrangler dev --config src/server/wrangler.jsonc --port 4174 --var DASHBOARD_ORIGIN:http://localhost:4000",
    "deploy:site-visits": "wrangler deploy --config src/server/wrangler.jsonc",
    "check:site-visits": "wrangler deploy --config src/server/wrangler.jsonc --dry-run",
    "dev:site-visits": "node src/server/dev.js"
  }
}
